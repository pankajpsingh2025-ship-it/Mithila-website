# Production build (Cloudflare Pages). This file IS committed (no secrets).
# No backend in this launch — ordering is WhatsApp / Instagram / Facebook.
REACT_APP_BACKEND_URL=
GENERATE_SOURCEMAP=false
# Cloudflare Pages sets CI=true, which makes CRA treat lint warnings as errors.
CI=false
DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true
